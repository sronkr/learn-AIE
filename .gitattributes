# Normalize line endings: Windows checks out CRLF, Mac/Linux LF, repo stores LF.
* text=auto eol=lf

# Binary files: never touch.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.mp4 binary
*.zip binary
*.gguf binary
*.safetensors binary
*.bin binary

# Shell scripts must stay LF even on Windows.
*.sh text eol=lf
